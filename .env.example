# =====================================================================
# BANTAI — Production Environment Configuration
# Apna Model. Apna Dimaag. Apna AI.
# 100% Self-Hosted. Zero Third-Party AI Inference APIs.
# =====================================================================

# ---------------------------------------------------------------------
# 1. CORE BACKEND SERVER
# ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=bantai-super-secret-production-jwt-key-change-in-prod-2026

# ---------------------------------------------------------------------
# 2. STRICT USER DATABASE (MongoDB — Identity & Profile ONLY)
# Permitted: User credentials, preferences, learning consent flags.
# STRICTLY FORBIDDEN: Conversations, messages, chat history.
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bantai_users

# ---------------------------------------------------------------------
# 3. CONVERSATION & APPLICATION STORAGE (Firebase Cloud Firestore / Local Emulator)
# Permitted: Conversations, messages, tasks, reminders, memories, docs.
# If omitted or unconfigured, BANTAI persists to user-isolated JSON store.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=bantai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bantai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...==\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=bantai-prod.appspot.com

# ---------------------------------------------------------------------
# 4. SOVEREIGN SELF-HOSTED AI INFERENCE ENGINE
# Zero OpenAI / Zero Anthropic / Zero Gemini / Zero Third-Party APIs.
# Options: ollama | llamacpp | vllm | local
# ---------------------------------------------------------------------
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------
# 5. BANTAI MODEL FAMILY MAPPING (Display Name -> Ollama Model Tag)
# ---------------------------------------------------------------------
# BANTAI Chhotu (3B)  : qwen2.5:3b
# BANTAI Bhai   (7B)  : qwen2.5:7b   [Default]
# BANTAI Ustad  (14B) : qwen2.5:14b
# BANTAI Don    (32B) : qwen2.5:32b
BANTAI_DEFAULT_MODEL=bhai

# ---------------------------------------------------------------------
# 6. WEB APPLICATION FRONTEND (Next.js 14)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS
# ---------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
