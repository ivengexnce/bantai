# =====================================================================
# BANTAI — Production Environment Configuration Template
# Apna Model. Apna Dimaag. Apna AI.
# 100% Self-Hosted. Zero Third-Party AI Inference APIs.
# =====================================================================

# ---------------------------------------------------------------------
# 1. CORE BACKEND SERVER
# ---------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# REQUIRED in production (>= 32 chars). Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_SECRET
JWT_EXPIRES_IN=7d
JWT_ISSUER=bantai-api
JWT_AUDIENCE=bantai-client
# Reverse proxy hops (set to 1 behind Nginx/Render/Vercel/Cloudflare, or false)
TRUST_PROXY=1
# Comma-separated exact origins allowed by CORS
CLIENT_URLS=https://app.example.com
# Data directory (use persistent volume path in Docker/production)
DATA_DIR=./data

# ---------------------------------------------------------------------
# 2. STRICT USER DATABASE (MongoDB — Identity & Profile ONLY)
# Permitted: User credentials, preferences, learning consent flags.
# STRICTLY FORBIDDEN: Conversations, messages, chat history.
# ---------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bantai_users

# ---------------------------------------------------------------------
# 3. CONVERSATION & APPLICATION STORAGE (Firebase Cloud Firestore)
# Permitted: Conversations, messages, tasks, reminders, memories, docs.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=bantai-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bantai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="REPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY"
FIREBASE_STORAGE_BUCKET=bantai-prod.appspot.com

# ---------------------------------------------------------------------
# 4. SOVEREIGN SELF-HOSTED AI INFERENCE ENGINE
# ---------------------------------------------------------------------
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_BASE_URL=http://localhost:8080
DEFAULT_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------
# 5. WEB APPLICATION FRONTEND (Next.js 14)
# NEVER place API keys in NEXT_PUBLIC_* variables!
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------
# 6. OPTIONAL SERVER-SIDE INTEGRATIONS (Backend ONLY — never expose to web)
# ---------------------------------------------------------------------
ELEVENLABS_API_KEY=
GOOGLE_CLIENT_ID=
