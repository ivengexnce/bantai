{
  "name": "bantai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BANTAI — Apna Model. Apna Dimaag. Apna AI. Production Self-Hosted Agentic AI Platform",
  "workspaces": [
    "frontend/*",
    "backend",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm --workspace=@bantai/backend run dev",
    "dev:web": "npm --workspace=@bantai/web run dev",
    "test": "npm --workspace=@bantai/backend run test",
    "test:security": "npm --workspace=@bantai/backend run test:security",
    "security:scan": "node tests/security_static_scan.mjs",
    "lint": "echo \"Linting all workspaces...\""
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.2"
  },
  "keywords": [
    "agentic-ai",
    "self-hosted",
    "mumbai-tapori",
    "personal-assistant",
    "fine-tuning",
    "rag"
  ],
  "author": "Meet Maru (https://github.com/ivengexnce)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivengexnce/bantai.git"
  },
  "license": "Apache-2.0"
}
