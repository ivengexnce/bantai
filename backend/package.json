{
  "name": "@bantai/backend",
  "version": "1.0.0",
  "description": "Production Node.js/TypeScript backend for BANTAI agentic AI platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/services/rag/unpdf_import.cjs','dist/services/rag/unpdf_import.cjs')\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ../tests/jest.config.js --runInBand",
    "test:security": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ../tests/jest.config.js --roots ../security --runInBand"
  },
  "author": "Meet Maru (https://github.com/ivengexnce)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivengexnce/bantai.git"
  },
  "dependencies": {
    "@bantai/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.1",
    "unpdf": "^2.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
