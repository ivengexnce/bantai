FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json ./
COPY shared/package.json ./shared/
COPY frontend/web/package.json ./frontend/web/

RUN npm install

COPY shared ./shared
COPY frontend/web ./frontend/web

RUN npm --workspace=@bantai/shared run build
RUN npm --workspace=@bantai/web run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/frontend/web/.next ./frontend/web/.next
COPY --from=builder /app/frontend/web/package.json ./frontend/web/package.json
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "--workspace=@bantai/web", "run", "start"]
